<Project Sdk="Microsoft.NET.Sdk">

  <!-- Opens the app's windows with fictional sample data and saves them as PNGs for the guide PDF. Not distributed. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DesktopLauncher\DesktopLauncher.csproj" />
  </ItemGroup>

</Project>
