<Window x:Class="DesktopLauncher.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="18">
        <CheckBox x:Name="MoveShortcutsBox">
            <TextBlock Text="ショートカット（.lnk / .url）を登録したら、元のファイルをごみ箱に移す" TextWrapping="Wrap" />
        </CheckBox>
        <TextBlock Margin="22,4,0,0" Foreground="#80868B" TextWrapping="Wrap"
                   Text="ランチャーには、ショートカットのコピーをアプリのフォルダー（data\links）に保存します。デスクトップなどのショートカットを片付けたいときに使います。" />

        <CheckBox x:Name="StartupBox" Margin="0,16,0,0" Content="Windows 起動時に開始" />
        <TextBlock Margin="22,4,0,0" Foreground="#80868B" TextWrapping="Wrap"
                   Text="オンにすると、Windows のスタートアップ（レジストリの HKCU\…\Run）に登録します。" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="OK" Width="80" IsDefault="True" Click="Ok_Click" />
            <Button Content="キャンセル" Width="80" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
