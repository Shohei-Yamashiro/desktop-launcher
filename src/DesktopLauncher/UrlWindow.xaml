<Window x:Class="DesktopLauncher.UrlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="URL を追加"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource ThemedWindow}">
    <StackPanel Margin="20,18,20,20">
        <TextBlock Text="URL" Margin="0,0,0,8" Style="{StaticResource SecondaryText}" />
        <TextBox x:Name="UrlBox" TextChanged="UrlBox_TextChanged" />
        <TextBlock Text="名前" Margin="0,16,0,8" Style="{StaticResource SecondaryText}" />
        <TextBox x:Name="NameBox" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="OK" MinWidth="88" IsDefault="True" Click="Ok_Click" />
            <Button Content="キャンセル" MinWidth="88" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
