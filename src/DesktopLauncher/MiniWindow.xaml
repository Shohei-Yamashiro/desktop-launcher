<Window x:Class="DesktopLauncher.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="#Hashelf（ミニ）"
        Width="64" Height="64"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="開く" FontWeight="Bold" Click="Open_Click" />
            <Separator />
            <MenuItem Header="終了" Click="Exit_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Grid Margin="8" Cursor="Hand">
        <Image x:Name="IconImage" RenderOptions.BitmapScalingMode="HighQuality">
            <Image.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.35" />
            </Image.Effect>
            <Image.Style>
                <Style TargetType="Image">
                    <Setter Property="Opacity" Value="0.85" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="1" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Image.Style>
        </Image>
    </Grid>
</Window>
