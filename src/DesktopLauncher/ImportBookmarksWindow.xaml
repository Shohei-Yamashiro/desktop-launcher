<Window x:Class="DesktopLauncher.ImportBookmarksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ブックマークの取り込み"
        Width="480" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource ThemedWindow}">
    <StackPanel Margin="20,18,20,20">
        <TextBlock Text="取り込み元" Margin="0,0,0,8" Style="{StaticResource SecondaryText}" />
        <ComboBox x:Name="SourceBox" AutomationProperties.Name="取り込み元" SelectionChanged="SourceBox_SelectionChanged" />
        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12" LineHeight="19" Style="{StaticResource SecondaryText}"
                   Text="Edge では「お気に入り」と呼ばれているものです。ブラウザのファイルは読むだけで、書き換えません。&#x0a;ほかのブラウザは、ブックマークを HTML ファイルに書き出してから「HTML ファイルから…」で選びます。" />

        <TextBlock Text="取り込むフォルダー" Margin="0,16,0,8" Style="{StaticResource SecondaryText}" />
        <Border Background="{StaticResource ControlBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                CornerRadius="8" Padding="6,4">
            <Grid>
                <TreeView x:Name="FolderTree" Background="Transparent" BorderThickness="0" MaxHeight="240" MinHeight="60"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                            <Setter Property="IsExpanded" Value="True" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,3">
                                <TextBlock>
                                    <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="{Binding CountText, Mode=OneWay}"
                                                                                  Foreground="{StaticResource TextTertiaryBrush}" />
                                </TextBlock>
                            </CheckBox>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
                <TextBlock x:Name="NoFoldersText" Margin="4,6" TextWrapping="Wrap" Visibility="Collapsed"
                           Style="{StaticResource SecondaryText}" />
            </Grid>
        </Border>

        <CheckBox x:Name="SkipExistingBox" Margin="0,14,0,0" IsChecked="True" Content="すでに登録してある URL は取り込まない" />
        <CheckBox x:Name="FavoriteBarBox" Margin="0,8,0,0" Content="お気に入りバー（ブックマークバー）の項目をお気に入りにする" />
        <TextBlock Margin="26,6,0,0" TextWrapping="Wrap" FontSize="12" LineHeight="19" Style="{StaticResource SecondaryText}"
                   Text="取り込んだ項目は、新しいグループ 1 つにまとめて入ります。要らなくなったら、そのグループを削除すれば元に戻せます。" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="ImportButton" Content="取り込む" MinWidth="88" IsDefault="True" Click="Import_Click" />
            <Button Content="キャンセル" MinWidth="88" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
