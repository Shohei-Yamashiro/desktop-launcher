<Window x:Class="DesktopLauncher.TagsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="タグを編集"
        Width="380" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource ThemedWindow}">
    <StackPanel Margin="20,18,20,20">
        <TextBlock x:Name="ItemNameText" TextTrimming="CharacterEllipsis" Style="{StaticResource SecondaryText}" />
        <TextBlock x:Name="NoteText" Margin="0,2,0,0" TextWrapping="Wrap" Visibility="Collapsed" Style="{StaticResource SecondaryText}"
                   Foreground="{StaticResource TextTertiaryBrush}" />
        <Border Height="10" />

        <Border Background="{StaticResource ControlBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                CornerRadius="8" Padding="10,6">
            <Grid>
                <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="TagList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" IsThreeState="{Binding IsMixed}" Margin="0,4">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{Binding Brush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="NoTagsText" Margin="0,4" Text="まだタグがありません。下の欄で新しく作れます。"
                           Style="{StaticResource SecondaryText}" />
            </Grid>
        </Border>

        <DockPanel Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="追加" MinWidth="64" Margin="8,0,0,0" Click="Add_Click" />
            <Grid>
                <TextBox x:Name="NewTagBox" AutomationProperties.Name="新しいタグ" PreviewKeyDown="NewTagBox_PreviewKeyDown" />
                <TextBlock Text="新しいタグ（Enter で追加）" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=NewTagBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DockPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="OK" MinWidth="88" IsDefault="True" Click="Ok_Click" />
            <Button Content="キャンセル" MinWidth="88" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
