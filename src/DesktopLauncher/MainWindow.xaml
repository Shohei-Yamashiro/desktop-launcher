<Window x:Class="DesktopLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Launcher"
        Width="760" Height="520" MinWidth="420" MinHeight="300"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#F5F6F8"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        Deactivated="Window_Deactivated">
    <Window.Resources>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <ContextMenu x:Key="ItemMenu" x:Shared="False">
            <MenuItem Header="開く" Click="Open_Click" FontWeight="Bold" />
            <MenuItem Header="ファイルの場所を開く" Click="OpenLocation_Click" />
            <Separator />
            <MenuItem Header="名前を変更" Click="Rename_Click" />
            <MenuItem Header="ランチャーから削除" Click="Remove_Click" />
        </ContextMenu>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E1E4E8" BorderThickness="0,0,0,1" Padding="12,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="ファイルを追加" Style="{StaticResource ToolButton}" Click="AddFile_Click" />
                    <Button Content="フォルダーを追加" Style="{StaticResource ToolButton}" Click="AddFolder_Click" />
                    <ToggleButton x:Name="PinButton" Content="固定" Padding="12,6" Margin="8,0,0,0"
                                  ToolTip="オンにすると、他のウィンドウをクリックしても隠れません。&#x0a;エクスプローラーからドラッグして追加するときに使います。" />
                </StackPanel>
                <Grid>
                    <TextBox x:Name="SearchBox" Padding="6,5" VerticalContentAlignment="Center"
                             TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown" />
                    <TextBlock Text="名前で絞り込み（Enter で先頭を起動、Esc で隠す）" Foreground="#9AA0A6" Margin="10,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>
        </Border>

        <Grid>
            <ListBox x:Name="ItemsList" Background="Transparent" BorderThickness="0" Padding="8"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     KeyDown="ItemsList_KeyDown">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="4" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="ToolTip" Value="{Binding Path}" />
                        <EventSetter Event="MouseLeftButtonUp" Handler="Item_MouseLeftButtonUp" />
                        <Setter Property="ContextMenu" Value="{StaticResource ItemMenu}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="96" Height="92" Margin="4">
                            <Image Source="{Binding Icon}" Width="32" Height="32" Margin="0,10,0,6" />
                            <TextBlock Text="{Binding Name}" TextAlignment="Center" TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis" MaxHeight="36" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" Foreground="#80868B" FontSize="14" IsHitTestVisible="False" />
        </Grid>
    </DockPanel>
</Window>
