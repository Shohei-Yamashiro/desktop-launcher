<Window x:Class="DesktopLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DesktopLauncher.Controls"
        Title="#Hashelf"
        Icon="Assets/app.ico"
        Width="480" Height="600" MinWidth="420" MinHeight="320"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Topmost="True"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        Deactivated="Window_Deactivated">
    <Window.Style>
        <Style TargetType="Window" BasedOn="{StaticResource ThemedWindow}" />
    </Window.Style>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="TitleButton" TargetType="ButtonBase" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>

        <Style x:Key="RowStyle" TargetType="Border">
            <Setter Property="Padding" Value="{DynamicResource RowPadding}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="ToolTip" Value="{Binding Path}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                    <Setter Property="ToolTip" Value="{x:Null}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DropPosition}" Value="Before">
                    <Setter Property="BorderThickness" Value="0,2,0,0" />
                    <Setter Property="CornerRadius" Value="0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DropPosition}" Value="After">
                    <Setter Property="BorderThickness" Value="0,0,0,2" />
                    <Setter Property="CornerRadius" Value="0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DropPosition}" Value="Into">
                    <Setter Property="Background" Value="{StaticResource DropIntoBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ItemIcon" TargetType="Image">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GroupGlyph" TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
            <Setter Property="Text" Value="&#xE8B7;" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter Property="Text" Value="&#xE838;" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The UI font draws glyphs about 1px below the middle of its line box. -->
        <TranslateTransform x:Key="OpticalCenter" Y="-1" />

        <Style x:Key="NameText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="RenderTransform" Value="{StaticResource OpticalCenter}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TagChip" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ToolTip" Value="クリックでこのタグの項目だけを表示（もう一度で解除）" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="11" Padding="9,2,10,3">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{Binding Brush}" Margin="0,1,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource ControlHoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="Background" Value="{StaticResource RowSelectedBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <controls:TagBrushConverter x:Key="TagBrush" />
        <SolidColorBrush x:Key="FavoriteBrush" Color="#E3B860" />

        <!-- 「すべて」「お気に入り」… above the search box; the chosen one is bright and underlined. -->
        <Style x:Key="ViewTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="10,5,10,0">
                            <StackPanel>
                                <ContentPresenter HorizontalAlignment="Center" />
                                <Border x:Name="Line" Height="2" CornerRadius="1" Margin="0,5,0,0" Background="Transparent" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlHoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Line" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Star at the start of a row; click to toggle. A favorite shows a filled star, other items a faint outline
             that brightens while the row is hovered. Groups keep the space empty so that icons stay aligned. -->
        <Style x:Key="FavoriteStar" TargetType="Button">
            <Setter Property="Tag" Value="star" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="お気に入りに追加（Ctrl+D）" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <TextBlock x:Name="Glyph" Text="&#xE734;" Style="{StaticResource Glyph}" FontSize="12"
                                       Foreground="{StaticResource TextTertiaryBrush}" Opacity="0.45" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DockPanel}}" Value="True">
                                <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                <Setter TargetName="Glyph" Property="Text" Value="&#xE735;" />
                                <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource FavoriteBrush}" />
                                <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                                <Setter Property="ToolTip" Value="お気に入りから外す（Ctrl+D）" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                    <Setter Property="Visibility" Value="Hidden" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Name followed by the node's tags; tags that do not fit end in "…".
             Own tags are tinted with the tag color; inherited tags (from enclosing groups) only get
             a gray dashed outline, a hollow dot and slightly dimmer text. -->
        <DataTemplate x:Key="RowTag">
            <Grid>
                <Border x:Name="Solid" BorderThickness="1" CornerRadius="8"
                        Background="{Binding Name, Converter={StaticResource TagBrush}, ConverterParameter=0.2}"
                        BorderBrush="{Binding Name, Converter={StaticResource TagBrush}, ConverterParameter=0.75}" />
                <Rectangle x:Name="Dashed" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1" StrokeDashArray="2 2"
                           RadiusX="8" RadiusY="8" Visibility="Collapsed" SnapsToDevicePixels="True" />
                <StackPanel Orientation="Horizontal" Margin="7,1,8,2">
                    <Ellipse x:Name="Dot" Width="6" Height="6" Fill="{Binding Name, Converter={StaticResource TagBrush}}"
                             Stroke="{Binding Name, Converter={StaticResource TagBrush}}" StrokeThickness="1.2"
                             Margin="0,1,5,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="Label" Text="{Binding Name}" FontSize="11" Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsInherited}" Value="True">
                    <Setter TargetName="Solid" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Dashed" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Dot" Property="Fill" Value="Transparent" />
                    <Setter TargetName="Label" Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="RowTagsPanel">
            <controls:OverflowPanel Spacing="4" Foreground="{StaticResource TextTertiaryBrush}" />
        </ItemsPanelTemplate>

        <Style x:Key="RowTags" TargetType="ItemsControl">
            <Setter Property="ItemsSource" Value="{Binding DisplayTags}" />
            <Setter Property="ItemTemplate" Value="{StaticResource RowTag}" />
            <Setter Property="ItemsPanel" Value="{StaticResource RowTagsPanel}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="MetaText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="RenderTransform" Value="{StaticResource OpticalCenter}" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Margin" Value="7" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <DockPanel>
            <Grid DockPanel.Dock="Top" Height="40" Background="{StaticResource HeaderBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="Assets/app.ico" Width="16" Height="16" Margin="14,0,10,0" />
                <TextBlock Grid.Column="1" FontSize="12" VerticalAlignment="Center" Style="{StaticResource SecondaryText}">
                    <Run Text="#" Foreground="{StaticResource TextTertiaryBrush}" /><Run Text="Hashelf" />
                </TextBlock>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,6,0" VerticalAlignment="Center">
                    <ToggleButton x:Name="PinButton" Style="{StaticResource TitleButton}" AutomationProperties.Name="固定"
                                  ToolTip="固定：オンにすると、他のウィンドウをクリックしても小さくなりません。&#x0a;エクスプローラーからドラッグして追加するときに使います。">
                        <TextBlock Text="&#xE718;" Style="{StaticResource Glyph}" />
                    </ToggleButton>
                    <Button Style="{StaticResource TitleButton}" AutomationProperties.Name="設定" ToolTip="設定"
                            Click="Settings_Click">
                        <TextBlock Text="&#xE713;" Style="{StaticResource Glyph}" />
                    </Button>
                    <Button Style="{StaticResource TitleButton}" AutomationProperties.Name="小さくする" ToolTip="小さくする（Esc）"
                            Click="Collapse_Click">
                        <TextBlock Text="&#xE921;" Style="{StaticResource Glyph}" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>

            <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,0,0,1" Padding="12,2,12,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="-4,0,0,8">
                        <RadioButton x:Name="AllTab" Style="{StaticResource ViewTab}" GroupName="View" IsChecked="True"
                                     Checked="ViewTab_Checked" AutomationProperties.Name="すべて" ToolTip="グループとタグで整理した、すべての項目">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8FD;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="すべて" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="FavoritesTab" Style="{StaticResource ViewTab}" GroupName="View"
                                     Checked="ViewTab_Checked" AutomationProperties.Name="お気に入り" ToolTip="お気に入りにした項目（Ctrl+D で追加・解除）">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE735;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="お気に入り" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                    <Grid>
                        <TextBox x:Name="SearchBox" Padding="32,7,8,7" AutomationProperties.Name="検索"
                                 TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"
                                 LostKeyboardFocus="SearchBox_LostKeyboardFocus" />
                        <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" HorizontalAlignment="Left" Margin="12,0,0,0"
                                   FontSize="13" Foreground="{StaticResource TextTertiaryBrush}" IsHitTestVisible="False" />
                        <TextBlock Text="名前・#タグで検索（Enter で結果を選択、Esc で小さくする）" Margin="34,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Existing tags that match the word being typed -->
                        <Popup x:Name="TagSuggest" PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom"
                               VerticalOffset="4" AllowsTransparency="True" StaysOpen="True" Focusable="False"
                               Width="{Binding ActualWidth, ElementName=SearchBox}">
                            <Border Background="{StaticResource PopupBrush}" BorderBrush="{StaticResource LineStrongBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="4">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="タグ（↑↓ で選んで Tab／Enter）" FontSize="11" Margin="8,2,8,4"
                                               Foreground="{StaticResource TextTertiaryBrush}" />
                                    <ListBox x:Name="SuggestList" Background="Transparent" BorderThickness="0" Focusable="False"
                                             HorizontalContentAlignment="Stretch" AutomationProperties.Name="タグの候補"
                                             PreviewMouseLeftButtonUp="SuggestList_PreviewMouseLeftButtonUp">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                                <Setter Property="Focusable" Value="False" />
                                                <Setter Property="Padding" Value="8,4" />
                                                <Setter Property="Cursor" Value="Hand" />
                                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel>
                                                    <Ellipse Width="7" Height="7" Fill="{Binding Brush}" Margin="0,1,8,0" VerticalAlignment="Center" />
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Style="{StaticResource MetaText}" />
                                                    <TextBlock VerticalAlignment="Center">
                                                        <Run Text="#" Foreground="{StaticResource TextTertiaryBrush}" /><Run Text="{Binding Name, Mode=OneWay}" />
                                                    </TextBlock>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>
                        </Popup>
                    </Grid>
                    <DockPanel Margin="-4,6,-4,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource GhostButton}" Click="ExpandAll_Click" AutomationProperties.Name="すべてのグループを開く"
                                    ToolTip="すべてのグループを開きます">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE838;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,5,0" />
                                    <TextBlock Text="開く" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Click="CollapseAll_Click" AutomationProperties.Name="すべてのグループを閉じる"
                                    ToolTip="すべてのグループを閉じます">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,5,0" />
                                    <TextBlock Text="閉じる" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource GhostButton}" Click="AddFile_Click" AutomationProperties.Name="＋ファイル"
                                    ToolTip="ファイルを追加します（選んでいるグループの中へ）">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="11" Margin="0,0,6,0" />
                                    <TextBlock Text="ファイル" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Click="AddFolder_Click" AutomationProperties.Name="＋フォルダー"
                                    ToolTip="フォルダーを追加します（選んでいるグループの中へ）">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="11" Margin="0,0,6,0" />
                                    <TextBlock Text="フォルダー" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Click="AddUrl_Click" AutomationProperties.Name="＋URL"
                                    ToolTip="URL を追加します（選んでいるグループの中へ）">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="11" Margin="0,0,6,0" />
                                    <TextBlock Text="URL" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Click="AddGroup_Click" AutomationProperties.Name="＋グループ"
                                    ToolTip="グループを作ります（選んでいるグループの中へ）">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="11" Margin="0,0,6,0" />
                                    <TextBlock Text="グループ" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl x:Name="TagBar" Margin="0,8,0,-6" Visibility="Collapsed" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource TagChip}" Click="TagChip_Click"
                                        AutomationProperties.Name="{Binding Name, StringFormat=タグ {0}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Grid>
                <TreeView x:Name="Tree" Background="Transparent" BorderThickness="0" Padding="8,6"
                          AllowDrop="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          SelectedItemChanged="Tree_SelectedItemChanged"
                          PreviewMouseLeftButtonDown="Tree_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="Tree_PreviewMouseMove"
                          PreviewMouseLeftButtonUp="Tree_PreviewMouseLeftButtonUp"
                          KeyDown="Tree_KeyDown"
                          ContextMenuOpening="List_ContextMenuOpening"
                          DragOver="Tree_DragOver"
                          DragLeave="Tree_DragLeave"
                          Drop="Tree_Drop">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsCurrent, Mode=TwoWay}" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <Border Tag="row" Style="{StaticResource RowStyle}">
                                <DockPanel>
                                    <Button Style="{StaticResource FavoriteStar}" Click="FavoriteStar_Click" />
                                    <Grid Width="20" Height="20" Margin="0,0,10,0">
                                        <Image Source="{Binding Icon}" Style="{StaticResource ItemIcon}" />
                                        <TextBlock Style="{StaticResource GroupGlyph}" />
                                    </Grid>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ChildCountText}" Style="{StaticResource MetaText}"
                                               Margin="8,0,0,0" />
                                    <controls:NameTagsPanel HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource NameText}" />
                                        <ItemsControl Style="{StaticResource RowTags}" />
                                    </controls:NameTagsPanel>
                                </DockPanel>
                            </Border>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <ListBox x:Name="SearchList" Background="Transparent" BorderThickness="0" Padding="8,6"
                         Visibility="Collapsed" HorizontalContentAlignment="Stretch" SelectionMode="Extended"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         KeyDown="SearchList_KeyDown"
                         SelectionChanged="SearchList_SelectionChanged"
                         ContextMenuOpening="List_ContextMenuOpening">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="ToolTip" Value="{Binding Path}" />
                            <Setter Property="Padding" Value="{DynamicResource SearchRowPadding}" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <EventSetter Event="MouseDoubleClick" Handler="SearchItem_MouseDoubleClick" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <Button Style="{StaticResource FavoriteStar}" Click="FavoriteStar_Click" />
                                <Image Source="{Binding Icon}" Style="{StaticResource ItemIcon}" Margin="0,0,10,0" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Location}" Style="{StaticResource MetaText}"
                                           Margin="12,0,0,0" />
                                <controls:NameTagsPanel HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource NameText}" />
                                    <ItemsControl Style="{StaticResource RowTags}" />
                                </controls:NameTagsPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="22"
                           TextAlignment="Center" Style="{StaticResource SecondaryText}" IsHitTestVisible="False" />
            </Grid>
        </DockPanel>
    </Border>
</Window>
